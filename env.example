# Copy to .env (or set in Vercel project settings).

# Zapier catch hook (never a GHL inbound webhook). Tanner maps it into GHL.
LEAD_WEBHOOK_URL=

# Vercel Blob storage for logo/headshot uploads. Auto-set when you attach a
# Blob store to the Vercel project (Storage tab -> Create -> Blob). Without it,
# uploads are noted in the payload but not stored.
BLOB_READ_WRITE_TOKEN=

# Resend enables BOTH emails (notification to Tanner + confirmation to broker).
# Leave blank to skip emails entirely (the success screen adapts, no email is promised).
# FROM_EMAIL must be a sender on a domain verified in Resend.
RESEND_API_KEY=
FROM_EMAIL=Tanner at CRE Loan Pro <tanner@creloanpro.com>
NOTIFY_EMAIL=tanner@creloanpro.com
